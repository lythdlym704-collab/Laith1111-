<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ScriptStudio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_build</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.ScriptStudio.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">6dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.ScriptStudio.Button.Check">
        <item name="android:background">@drawable/btn_bg_indigo</item>
    </style>

    <style name="Widget.ScriptStudio.Button.Build">
        <item name="android:background">@drawable/btn_bg_green</item>
    </style>

    <style name="Widget.ScriptStudio.Button.Gold">
        <item name="android:background">@drawable/btn_bg_gold</item>
        <item name="android:textColor">#1F1300</item>
        <item name="iconTint">#1F1300</item>
    </style>

</resources>
